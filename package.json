{
  "name": "@crnl/ui",
  "version": "0.1.0",
  "description": "Crnl — a token-based CSS design system with a typed React layer, light and dark modes, and pluggable theming",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crnl-ui/crnl.git"
  },
  "homepage": "https://github.com/crnl-ui/crnl#readme",
  "bugs": {
    "url": "https://github.com/crnl-ui/crnl/issues"
  },
  "author": "Cornelius Hegeman",
  "type": "module",
  "private": true,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./crnl.css": "./css/crnl.css",
    "./css/*": "./css/*",
    "./fonts/*": "./fonts/*",
    "./images/*": "./images/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "css",
    "fonts",
    "images",
    "RULES.md"
  ],
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "npm run build:css-bundle && vite build",
    "build-storybook": "storybook build",
    "preview": "vite preview",
    "prepack": "npm run build",
    "check": "npm run check:themes && npm run check:assets && npm run check:icons && npm run check:exports && npm run check:demo",
    "check:themes": "node scripts/check-themes.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "check:icons": "node scripts/check-icons.mjs",
    "check:visual": "node scripts/visual.mjs",
    "check:demo": "node demo/check-coverage.mjs",
    "build:css-api": "node scripts/generate-css-reference.js",
    "build:css-bundle": "node scripts/build-css-bundle.mjs",
    "build:docs": "npm run build:css-api && npm run build:css-bundle",
    "build:fonts": "python3 scripts/build-fonts.py",
    "build:ui-fonts": "python3 scripts/build-ui-fonts.py",
    "check:all": "npm run check && npm run check:visual",
    "check:exports": "node scripts/check-exports.mjs"
  },
  "dependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/react-vite": "^8.4.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@xmldom/xmldom": "^0.9.12",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "storybook": "^8.4.7",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^4.3.0"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "keywords": [
    "design-system",
    "css",
    "design-tokens",
    "theming",
    "react",
    "typescript"
  ],
  "license": "MIT"
}
